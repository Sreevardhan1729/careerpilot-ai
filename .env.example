# CareerPilot AI — environment variables (names only; never commit values)
# Full descriptions: docs/DEPLOYMENT.md §9
# Backend reads backend/.env; frontend reads frontend/.env.local (NEXT_PUBLIC_* only).

# --- Core ---
APP_ENV=local
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

# --- Database ---
# Leave empty locally: an embedded Postgres 16 + pgvector starts automatically in backend/.pgdata
DATABASE_URL=
EMBEDDED_PG_DIR=./.pgdata
DB_POOL_SIZE=5

# --- Auth ---
AUTH_MODE=dev
ALLOWED_USER_EMAILS=
# Production refuses to start without ALLOWED_USER_EMAILS unless this is true
ALLOW_OPEN_SIGNUP=false
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SECRET_KEY=
DEV_AUTH_EMAIL=owner@careerpilot.local
# Local dev token signing secret (ignored in production; AUTH_MODE=dev is refused there)
DEV_AUTH_SECRET=

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_BUCKET_RESUMES=resumes
LOCAL_STORAGE_DIR=./.storage
MAX_UPLOAD_MB=5
MAX_RESUME_PAGES=20

# --- LLM (spec §5.4: verify model ID against your endpoint with scripts/check_llm.py) ---
# none = deterministic rule-based mode (no key needed); nvidia = Nemotron via NVIDIA endpoint
LLM_PROVIDER=none
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_STRUCTURED_OUTPUT_MODE=auto
LLM_DAILY_CALL_BUDGET=200
LLM_MAX_CONCURRENCY=2

# --- Embeddings (dimension must match the migration) ---
# hashing = local deterministic vectors (no key); nvidia = NVIDIA embedding model
EMBEDDING_PROVIDER=hashing
NVIDIA_EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024

# --- Tasks / scheduler ---
TASK_RUNNER_ENABLED=true
TASK_RUNNER_CONCURRENCY=2
TASK_LEASE_SECONDS=300
TASK_POLL_SECONDS=1
# memory (default) or postgres (persistent LangGraph checkpoints, schema 'langgraph')
CHECKPOINTER=memory
SCHEDULER_TOKEN=
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Fetching / discovery ---
CRAWLER_USER_AGENT=CareerPilotBot/1.0 (+https://example.com/contact)
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_BYTES=2097152
BLOCKED_FETCH_HOSTS=linkedin.com
PLAYWRIGHT_ALLOWED_DOMAINS=
DISCOVERY_MAX_SOURCES_PER_RUN=20
DISCOVERY_MAX_LISTINGS_PER_SOURCE=100
DISCOVERY_MAX_NEW_JOBS_ANALYZED_PER_RUN=40
PEOPLE_DISCOVERY_MAX_JOBS_PER_RUN=5

# --- People search (optional) ---
SEARCH_PROVIDER=none
SEARCH_API_KEY=
SEARCH_CSE_ID=
SEARCH_DAILY_QUERY_BUDGET=30

# --- Gmail (Phase 3) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEYS=

# --- Outreach / limits ---
LINKEDIN_CONNECTION_NOTE_MAX_CHARS=200
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_LLM_ENQUEUE_PER_HOUR=30

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AUTH_MODE=dev
