# CareerPilot AI frontend — copy to .env.local. Only these NEXT_PUBLIC_* values reach the browser; never add secrets here.

# FastAPI base URL including the /api/v1 prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# "dev" (email-only local sign-in via POST /dev/login) or "supabase" (magic-link sign-in).
NEXT_PUBLIC_AUTH_MODE=dev

# Required only when NEXT_PUBLIC_AUTH_MODE=supabase. The publishable (anon) key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
